---
import { profile } from '../data/profile';
import SoundControl from './SoundControl.astro';

const navItems = [
  { id: 'work', label: 'Work' },
  { id: 'capabilities', label: 'Capabilities' },
  { id: 'approach', label: 'Approach' },
  { id: 'about', label: 'About' },
  { id: 'contact', label: 'Contact' },
] as const;
---

<header class="site-header" data-site-header>
  <div class="shell site-header__inner">
    <a class="site-mark" href="#top" aria-label="Back to top">
      {profile.name}
      <span data-decode>{profile.callsign}</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      Menu
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Site" data-site-nav>
      {navItems.map((item) => (
        <a href={`#${item.id}`} data-nav-link data-decode>{item.label}</a>
      ))}
    </nav>

    <SoundControl />
  </div>
</header>
